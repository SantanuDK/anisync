{
  "manifest_version": 3,
  "name": "AniSync - MyAnimeList Auto Tracker",
  "version": "1.0.0",
  "description": "Automatically detects the anime and episode you are watching on streaming sites and syncs your progress to MyAnimeList.",
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "AniSync",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage",
    "identity",
    "notifications",
    "alarms",
    "activeTab"
  ],
  "host_permissions": [
    "https://api.myanimelist.net/*",
    "https://myanimelist.net/*",
    "https://api.aniskip.com/*",
    "https://everythingmoe.com/*",
    "https://anisync-api.YOUR-SUBDOMAIN.workers.dev/*"
  ],
  "content_scripts": [
    {
      "matches": ["*://*/*"],
      "js": ["content/detector.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  }
}
